  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test && npm run build",
    "gallery:dev": "vite --config gallery/vite.config.ts",
    "gallery:build": "tsc --project gallery/tsconfig.json && vite build --config gallery/vite.config.ts",
    "visual:install": "playwright install --with-deps chromium",
    "visual:test": "playwright test",
    "visual:update": "playwright test --update-snapshots",
    "check:visual": "npm run visual:test",
    "verify:subpaths": "node scripts/verify-subpath-imports.mjs",
    "check:subpaths": "npm run build && npm run verify:subpaths",
    "check:all": "npm run check && npm run gallery:build",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.5",
    "vitest": "^2.1.9",
    "vitest-axe": "^0.1.0"
  }
